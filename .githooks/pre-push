#!/usr/bin/env bash
set -euo pipefail

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "${remote_ref:-}" ]; then
    continue
  fi
  if [ "$remote_ref" = "refs/heads/main" ]; then
    blocked=1
  fi
done

if [ "$blocked" -eq 1 ]; then
  cat >&2 <<'MSG'

  [거부] main 으로 직접 푸시할 수 없습니다.

  main 은 PR 로만 갱신됩니다.

  Claude Code 를 쓰고 있다면 /deliver 하나로 끝납니다.
  커밋과 동기화와 푸시와 PR 생성을 한 번에 수행합니다.

  터미널에서 직접 하려면 작업 브랜치를 만들어 그쪽으로 푸시한 뒤
  GitHub 화면에서 PR 을 여십시오.

      git switch -c feat/이슈번호-작업요약
      git push -u origin HEAD

MSG
  exit 1
fi

exit 0

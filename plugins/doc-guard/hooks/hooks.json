      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"${CLAUDE_PLUGIN_ROOT}/../..\" python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_write_guard.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
